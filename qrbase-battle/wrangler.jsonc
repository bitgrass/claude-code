{
  // Set secrets with Wrangler instead of committing them here:
  // wrangler secret put DATABASE_URL
  // wrangler secret put PRIVY_APP_SECRET
  // wrangler secret put MORALIS_API_KEY
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "qrbase-battle",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-03-10",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_PUBLIC_PRIVY_APP_ID": "cmnr8g8ob002d0dl2jxonao0b",
    "NEXT_PUBLIC_QRBASE_API_URL": "https://qrbase.xyz/api",
    "NEXT_PUBLIC_CHAIN_ID": "8453",
    "NEXT_PUBLIC_BASE_RPC_URL": "https://site1.moralis-nodes.com/base/a9377391d4f34bdc804a9847fc0d7f30"
  }
}
