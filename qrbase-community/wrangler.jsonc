{
  // Set secrets with Wrangler instead of committing them here:
  // wrangler secret put PRIVY_APP_SECRET
  // wrangler secret put FARCASTER_PRIVY_APP_SECRET
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "qrbase-community",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-03-10",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_PUBLIC_PRIVY_APP_ID": "cmiqj3rdf003fle0cjvt9egb5",
    "NEXT_PUBLIC_FARCASTER_PRIVY_APP_ID": "cmeifjj1400sakv0b2dn2fjz7",
    "NEXT_PUBLIC_QRBASE_API_URL": "https://qrbase.xyz/api",
    "NEXT_PUBLIC_CHAIN_ID": "8453"
  }
}
