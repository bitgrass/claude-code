{
  // Set secrets with Wrangler instead of committing them here:
  // wrangler secret put PRIVY_APP_SECRET
  // wrangler secret put RELAYER_PRIVATE_KEY
  // wrangler secret put QRBASE_API_SECRET
  // wrangler secret put DATABASE_URL
  // wrangler secret put UPSTASH_REDIS_URL
  // wrangler secret put UPSTASH_REDIS_TOKEN
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "qrbase-airdrop",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-03-10",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "airdrop.qrbase.xyz/*", "zone_name": "qrbase.xyz" }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_PUBLIC_CHAIN_ID": "8453",
