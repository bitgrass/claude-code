{
  "name": "qrbase-airdrop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate --no-engine"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "@prisma/extension-accelerate": "^3.0.1",
    "@privy-io/react-auth": "^1.88.0",
    "@privy-io/server-auth": "^1.14.0",
    "@rainbow-me/rainbowkit": "^2.2.10",
    "@tanstack/react-query": "^5.60.0",
    "@upstash/redis": "^1.34.0",
    "alchemy-sdk": "^3.4.0",
    "framer-motion": "^11.11.0",
    "next": "^14.2.0",
    "pg": "^8.13.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "viem": "^2.21.0",
    "wagmi": "^2.14.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.8.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "postcss": "^8.4.0",
    "prisma": "^6.16.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.20.0"
  }
}
