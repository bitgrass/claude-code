generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Campaign {
  id              String    @id @default(cuid())
  onChainId       Int       @unique
  creatorWallet   String
  name            String
  tokenSymbol     String    // e.g. "SCAN"
  tokenAddress    String    // ERC-20 address for balance check
  totalUsdc       BigInt    // Total USDC deposited (6 decimals)
  maxRecipients   Int
  tiers           Json      // [{ position: 1, amount: 500000000 }, ...]
  eligibilityRules Json     // [{ type: "puzzle_wins", token: "SCAN", min: 20 }, ...]
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  closedAt        DateTime?
  claims          Claim[]

  @@index([isActive])
  @@index([creatorWallet])
}

model Claim {
  id            String   @id @default(cuid())
  campaignId    String
  campaign      Campaign @relation(fields: [campaignId], references: [id])
  twitterId     String
  twitterHandle String
  walletAddress String
  usdcAmount    BigInt   // 6 decimals
  slotNumber    Int      // 1st, 2nd, 3rd claimer
  txHash        String?
  claimedAt     DateTime @default(now())

  @@unique([campaignId, twitterId])
  @@unique([campaignId, walletAddress])
  @@index([campaignId])
}
