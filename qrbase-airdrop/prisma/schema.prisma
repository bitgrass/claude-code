generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SplitType {
  EQUAL
  RANDOM
}

model Campaign {
  id             String    @id @default(cuid())
  onChainId      Int       @unique
  creatorWallet  String
  creatorTwitter String?
  totalAmount    BigInt
  maxRecipients  Int
  splitType      SplitType
  isActive       Boolean   @default(true)
  antiBot        Json
  createdAt      DateTime  @default(now())
  closedAt       DateTime?
  claims         Claim[]

  @@index([isActive])
  @@index([creatorWallet])
}

model Claim {
  id            String   @id @default(cuid())
  campaign      Campaign @relation(fields: [campaignId], references: [id])
  campaignId    String
  twitterId     String
  twitterHandle String
  walletAddress String
  amount        BigInt
  txHash        String?
  claimedAt     DateTime @default(now())

  @@unique([campaignId, twitterId])
  @@unique([campaignId, walletAddress])
  @@index([campaignId])
}
